# ==============================================================================
# BINANCE LIVE PRODUCTION ACCOUNT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and replace with your actual Binance API credentials:
#   cp .env.example .env
#
# Ensure API Key permissions on Binance:
#   [x] Enable Reading
#   [x] Enable Spot & Margin Trading
#   [ ] Enable Withdrawals (LEAVE UNCHECKED - FOR SAFETY)

EXCHANGE_API_KEY=your_binance_api_key_here
EXCHANGE_API_SECRET=your_binance_api_secret_here

# Execution mode: false for real live Binance trading, true for testnet
EXCHANGE_SANDBOX=false
LIVE_TRADING_ENABLED=true
MAX_ALLOCATED_CAPITAL=50.0
MIN_NOTIONAL_USD=10.0

# ==============================================================================
# DATA INGESTION & MARKET METRICS
# ==============================================================================
SYMBOL=BTC/USDT
TIMEFRAME=1m
INITIAL_FETCH_BARS=100
DATA_DIR=data
DB_PATH=data/trading.db

# ==============================================================================
# AI FOUNDATION & MACHINE LEARNING MODELS
# ==============================================================================
MODEL_DIR=models
CHRONOS_MODEL=amazon/chronos-t5-tiny
CHRONOS_CONTEXT_LEN=64
FORECAST_HORIZON=12

# ==============================================================================
# DETERMINISTIC RISK SHIELD & EXECUTION RULES
# ==============================================================================
INITIAL_CAPITAL=50.0
MAX_RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.04
MAX_OPEN_POSITIONS=1
TAKER_FEE=0.0010
SLIPPAGE=0.0005
LABEL_THRESHOLD=0.0015

# ==============================================================================
# THREE LIVES / SURVIVAL ENGINE
# ==============================================================================
SURVIVAL_ALPHA=0.50
SURVIVAL_BETA=1.00
SURVIVAL_GAMMA=1.50
SURVIVAL_DELTA=0.10
SURVIVAL_FLOOR=0.10

# ==============================================================================
# AUTOMATION & SERVER SETTINGS
# ==============================================================================
AUTO_LOOP_INTERVAL_SEC=15
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
